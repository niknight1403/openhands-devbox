# Lokale Offline-Route — gilt für alle Agenten-, Planungs- und Code-Schleifen.
#
# Diese Werte liest scripts/local_llm_router.py. Im Offline-Modus (LLM_OFFLINE=1)
# schreibt das Skript daraus die Laufzeitvariablen in die ignorierte .env und
# weder der Free Route Hunter noch der LLM-Autopilot fragen Cloud-Anbieter.
#
# Anpassen, wenn der Router anders heißt oder auf einer anderen Adresse läuft:
#   - Ollama im Docker-Container:   http://host.docker.internal:11434/v1
#   - Ollama im Codespace/Host:     http://127.0.0.1:11434/v1
#   - LiteLLM-Proxy:                http://127.0.0.1:4000/v1
#   - zweite Maschine im LAN:       http://192.168.1.20:11434/v1
#
# Umgebungsvariablen derselben Namen überschreiben diese Datei, ohne dass sie
# hier geändert werden muss.

# 1 = ausschließlich lokale Route, kein Cloud-Fallback. 0 = Cloud-Jagd erlaubt.
LLM_OFFLINE=1

# Harte Sperre: ein Endpunkt, der nicht lokal ist, wird abgelehnt statt genutzt.
LOCAL_LLM_STRICT=1

# OpenAI-kompatibler Endpunkt des eigenen Routers (Basis-URL ohne /chat/completions).
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# Modell-ID des lokalen Routers, ohne LiteLLM-Präfix.
LOCAL_LLM_MODEL=qwen2.5-coder:7b

# LiteLLM-Präfix der OpenAI-kompatiblen Route. Leer lassen für die nackte
# Modell-ID (z. B. "qwen2.5-coder:7b" statt "openai/qwen2.5-coder:7b").
LOCAL_LLM_LITELLM_PREFIX=openai/

# Platzhalter: der lokale Router ignoriert den Schlüssel, das Client-SDK verlangt ihn.
LOCAL_LLM_API_KEY=local-dummy-key

# Timeout je Prüfaufruf in Sekunden.
LOCAL_LLM_TIMEOUT=20
