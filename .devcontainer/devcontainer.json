{
  "name": "OpenHands Devbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "OpenHands UI",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "mkdir -p openhands-state",
  "postStartCommand": "docker compose up -d && echo 'OpenHands startet — UI auf Port 3000, sobald der Healthcheck gruen ist.'",
  "customizations": {
    "codespaces": {
      "openInBrowser": false
    }
  }
}
