{
  "name": "OpenHands Devbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000],
  "postCreateCommand": "mkdir -p openhands-state",
  "postStartCommand": "docker compose up -d && echo 'OpenHands startet — Port 3000 ist gleich erreichbar.'",
  "customizations": {
    "codespaces": {
      "openInBrowser": false
    }
  }
}
